# Leave these blank (or unset) to run in DEMO MODE — the app uses browser-local
# sample data and never contacts a backend. This is how the public deployment
# stays a safe sandbox. Fill them in to run against your own Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Force demo mode even when the two values above are set (handy for a demo build):
# VITE_DEMO_MODE=true
